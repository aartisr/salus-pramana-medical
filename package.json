{
  "name": "salus-pramana-medical",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm:start:client\" \"npm:start:server\"",
    "start": "npm run start:server",
    "start:client": "vite --host 127.0.0.1 --port 5173",
    "start:server": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "test:contracts": "vitest run tests/config tests/server",
    "test:integration": "vitest run tests/server",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:visual": "playwright test tests/visual",
    "audit:visual": "node scripts/audit-visual.mjs",
    "test:performance": "vitest run --passWithNoTests tests/performance",
    "validate": "tsx scripts/validate.ts",
    "check:aws": "bash scripts/check-aws-deploy-prereqs.sh",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "seed:aws": "tsx src/server/seed-dynamodb.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1143.0",
    "@aws-sdk/lib-dynamodb": "^3.1143.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "4.22.3",
    "katex": "^0.18.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "topojson-client": "^3.1.0",
    "vite": "^8.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.11",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "overrides": {
    "lightningcss": "1.33.0"
  }
}
